# =============================================================================
# Supabase — Authentication & Database
# =============================================================================

# Your Supabase project URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabase anonymous (public) key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Supabase service role key — server-side only, grants full DB access bypassing RLS
SUPABASE_SERVICE_ROLE_KEY=""

# =============================================================================
# Supabase S3-Compatible Storage
# =============================================================================

# Access key ID for Supabase Storage S3 API (found in Storage > S3 Access Keys)
SUPABASE_S3_ACCESS_KEY_ID=""

# Secret access key for Supabase Storage S3 API
SUPABASE_S3_SECRET_ACCESS_KEY=""

# AWS region where your Supabase project is hosted (e.g. ap-south-1)
SUPABASE_S3_REGION="ap-south-1"

# S3-compatible endpoint URL for Supabase Storage (e.g. https://<project>.supabase.co/storage/v1/s3)
SUPABASE_S3_ENDPOINT=""

# =============================================================================
# MongoDB Atlas — Document Storage
# =============================================================================

# MongoDB Atlas connection string (e.g. mongodb+srv://<user>:<password>@cluster.mongodb.net/<db>)
MONGODB_URI=""

# =============================================================================
# Google — Drive Integration & OAuth
# =============================================================================

# Google API key for public Drive folder access (no OAuth required)
GOOGLE_API_KEY=""

# Google Drive folder ID to list files from (the folder's ID in the Drive URL)
GOOGLE_DRIVE_FOLDER_ID=""

# Google OAuth 2.0 client ID (from Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=""

# Google OAuth 2.0 client secret
GOOGLE_CLIENT_SECRET=""
